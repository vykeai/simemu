{
  "schemaVersion": "onlytools.manifest.v1",
  "slug": "simemu",
  "name": "Simemu",
  "catalogSlug": "simemu",
  "version": {
    "source": "pyproject",
    "path": "pyproject.toml"
  },
  "serviceMode": "cli-only",
  "environments": [
    {
      "slug": "prod",
      "displayName": "Production",
      "configRoot": "~/.simemu",
      "dataRoot": "~/.simemu",
      "cacheRoot": "~/.simemu/cache",
      "serviceSlug": "simemu",
      "fedIdentity": "simemu",
      "inheritsFrom": null
    },
    {
      "slug": "dev",
      "displayName": "Development",
      "configRoot": "~/.simemu-dev",
      "dataRoot": "~/.simemu-dev",
      "cacheRoot": "~/.simemu-dev/cache",
      "serviceSlug": "simemu-dev",
      "fedIdentity": "simemu-dev",
      "inheritsFrom": null
    }
  ],
  "commands": {
    "install": {
      "argv": [
        "python3",
        "-m",
        "pip",
        "install",
        "-e",
        "."
      ],
      "cwd": ".",
      "timeoutSeconds": 300
    },
    "build": {
      "argv": [
        "python3",
        "-m",
        "build"
      ],
      "cwd": ".",
      "outputs": [
        "dist/"
      ],
      "timeoutSeconds": 600
    },
    "test": {
      "argv": [
        "python3",
        "-m",
        "pytest",
        "tests/",
        "-x",
        "-q"
      ],
      "cwd": ".",
      "timeoutSeconds": 900
    }
  },
  "services": [],
  "dependencies": [],
  "proof": {
    "receipts": [
      {
        "kind": "onlytools.test",
        "requiredFor": [
          "test"
        ],
        "provider": "proofy"
      }
    ],
    "sentinel": {
      "required": true,
      "checks": [
        "manifest",
        "graph"
      ]
    }
  }
}
